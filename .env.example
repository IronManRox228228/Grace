# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
# Empty values are IGNORED (the config.py default is used instead), so delete a
# line rather than blanking it if you want the default. Values already present
# in the real environment always win over this file.

# --- Secrets -----------------------------------------------------------------
# Google AI Studio key. Grace only ever calls gemini-3.1-flash-lite.
# Leave empty to run fully local against llama-server.
GEMINI_API_KEY=

# --- Runtime & Backend Selection ---------------------------------------------
# GRACE_BACKEND: 'rust' (default, native sidecar) or 'python' (deprecated).
GRACE_BACKEND=rust
# Preset fleet architecture: 'cpu-fleet' (sub-1B models for CPU floor) or 'gpu-single' (Holo3.1-4B).
GRACE_PRESET=cpu-fleet
# Hardware tier override ('floor', 'middle', 'best'). Leave empty to auto-detect.
HARDWARE_TIER=
# CPU thread cap for ONNX/llama runtimes (0 = auto-detect based on physical cores).
THREAD_BUDGET=0
# Windows process priority management.
PROCESS_PRIORITY_CONTROL=true

# --- Model paths -------------------------------------------------------------
# Holo3.1-4B is the single local model for all LLM slots (tool calling, planning,
# element selection, confirmation, routing, visual grounding). The mmproj file is
# required for vision capabilities.
LLAMA_MODEL_PATH=C:\path\to\Holo-3.1-4B.Q4_K_M.gguf
LLAMA_MMPROJ_PATH=C:\path\to\Holo-3.1-4B.mmproj-q8_0.gguf
# Coordinate format for the vision grounder: 0-1000, 0-1, or pixels.
GROUNDER_COORDINATE_FORMAT=0-1000
KOKORO_VOICES_PATH=C:\Users\<you>\.cache\huggingface\hub\models--hexgrad--Kokoro-82M\snapshots\<snapshot>\voices\af_bella.pt

# --- llama-server ------------------------------------------------------------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CONTEXT_WINDOW=8192
LLAMA_NGL=999
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16
LLAMA_FLASH_ATTN=true
LLAMA_PARALLEL_SLOTS=1
# LLAMA_SERVER_EXE=C:\path\to\llama.cpp\llama-server.exe

# --- Cloud LLM (Disabled by default - offline first) -----------------------
USE_CLOUD_LLM=false
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
# NVIDIA NIM fallback: used only when Gemini returns HTTP 429 (quota exhausted).
# Leave empty to never fall back to NVIDIA.
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=nemotron-3.5-lightning-30b-a3b
# If cloud LLM is ever enabled, screenshots are never sent without explicit consent:
ALLOW_CLOUD_SCREENSHOTS=false

# --- Local WebSocket Auth Token (per-launch token, leave empty to auto-generate)
GRACE_WS_TOKEN=

# --- Speech & Audio Engines --------------------------------------------------
# Engine selection: stt ('whisper' or 'sherpa'), tts ('kokoro' or 'sherpa'),
# wake ('vosk' or 'sherpa'), vad ('silero').
STT_ENGINE=whisper
TTS_ENGINE=kokoro
WAKE_ENGINE=vosk
VAD_ENGINE=silero
SHERPA_ASR_MODEL_TYPE=parakeet

# --- Audio -------------------------------------------------------------------
MIC_DEVICE_INDEX=-1
MIC_SAMPLE_RATE=16000
MIC_CHUNK=512
MIC_CHANNELS=1
MIC_WIDTH=2
FOLLOWUP_TIMEOUT_SECONDS=10
INITIAL_LISTEN_TIMEOUT_SECONDS=6.0

# --- Wake word (Vosk) --------------------------------------------------------
VOSK_KEYWORD=grace
VOSK_THRESHOLD=0.4

# --- Whisper -----------------------------------------------------------------
WHISPER_MODEL_PATH=small
WHISPER_VAD_THRESHOLD=0.008
WHISPER_SILENCE_DURATION_MS=1200

# --- Kokoro TTS --------------------------------------------------------------
# Workers share a single KModel, so this is concurrency, not model copies.
KOKORO_WORKERS=2
KOKORO_DEVICE=cuda
KOKORO_DTYPE=float32
KOKORO_WARMUP=true
KOKORO_CACHE_SIZE=32
KOKORO_SPEED=1.0

# --- Agent -------------------------------------------------------------------
# Steps stay unlimited: capping them abandons a task that is making progress.
AGENT_MAX_ITERATIONS=0
# Time and quota are the real ceilings, and they bound the failure rather than
# the task. 0 disables either, at the cost of nothing structurally preventing a
# goal from running until the LLM provider rate-limits it.
AGENT_MAX_SECONDS=180
PLANNER_MAX_CALLS_PER_GOAL=40
AGENT_MAX_CONSECUTIVE_PLAN_FAILURES=3
AGENT_MAX_REPEATED_ACTIONS=3
STRONGER_PLANNER_MODEL=gemini-3.1-flash
SCREENSHOT_MAX_WIDTH=1280
# Fewest actionable controls a window can report and still be planned for from
# its element list rather than from a marked screenshot.
OBSERVABILITY_MIN_ACTIONABLE=8

# Browser DOM via Chrome DevTools Protocol. Attach-only: Grace never launches a
# browser with a debug flag and never touches your profile. 0 = disabled, in
# which case browser elements come from the UIA/ARIA tree (all browsers).
GRACE_CDP_PORT=0

# OculiX/JPype visual fallback. Starts a JVM in-process; off by default.
USE_OCULIX=false

# --- Logging -----------------------------------------------------------------
# DEBUG formats a log line per 32ms audio chunk. Use only when debugging.
GRACE_LOG_LEVEL=INFO

# --- WebSocket (frontend) ----------------------------------------------------
WS_HOST=127.0.0.1
WS_PORT=8765
# Extra origins to accept connections from, beyond the built-in Tauri/dev
# allowlist (comma-separated). Leave empty unless the renderer is served from
# somewhere non-standard.
WS_ALLOWED_ORIGINS=
