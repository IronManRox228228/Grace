# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
# Empty values are IGNORED (the config.py default is used instead), so delete a
# line rather than blanking it if you want the default. Values already present
# in the real environment always win over this file.

# --- Secrets -----------------------------------------------------------------
# Google AI Studio key. Grace only ever calls gemini-3.1-flash-lite.
# Leave empty to run fully local against llama-server.
GEMINI_API_KEY=

# --- Model paths -------------------------------------------------------------
# UI-TARS is the GUI grounding model. The mmproj file is required for vision;
# without it llama-server starts but UI-TARS runs blind.
LLAMA_MODEL_PATH=C:\path\to\UI-TARS-1.5-7B.Q4_K_M.gguf
LLAMA_MMPROJ_PATH=C:\path\to\UI-TARS-1.5-7B.mmproj-Q8_0.gguf
# Optional: a separate local model for the planner role, used only when
# USE_CLOUD_LLM=false. Leave empty to keep the planner on Gemini - then only
# UI-TARS needs the GPU and nothing has to swap. Set this to run fully local;
# Grace will hot-swap one llama-server process between this model and UI-TARS
# rather than trying to keep both loaded on one GPU at once.
LLAMA_PLANNER_MODEL_PATH=
KOKORO_VOICES_PATH=C:\Users\<you>\.cache\huggingface\hub\models--hexgrad--Kokoro-82M\snapshots\<snapshot>\voices\af_bella.pt

# --- llama-server ------------------------------------------------------------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CONTEXT_WINDOW=8192
LLAMA_NGL=999
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16

# --- Cloud LLM ---------------------------------------------------------------
USE_CLOUD_LLM=true
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
USE_UI_TARS_LOCAL=true

# --- Audio -------------------------------------------------------------------
MIC_DEVICE_INDEX=-1
MIC_SAMPLE_RATE=16000
MIC_CHUNK=512
MIC_CHANNELS=1
MIC_WIDTH=2
FOLLOWUP_TIMEOUT_SECONDS=10
INITIAL_LISTEN_TIMEOUT_SECONDS=6.0

# --- Wake word (Vosk) --------------------------------------------------------
VOSK_KEYWORD=grace
VOSK_THRESHOLD=0.4

# --- Whisper -----------------------------------------------------------------
WHISPER_MODEL_PATH=small
WHISPER_VAD_THRESHOLD=0.008
WHISPER_SILENCE_DURATION_MS=1200

# --- Kokoro TTS --------------------------------------------------------------
# Workers share a single KModel, so this is concurrency, not model copies.
KOKORO_WORKERS=2
KOKORO_DEVICE=cuda
KOKORO_DTYPE=float32
KOKORO_WARMUP=true
KOKORO_CACHE_SIZE=32
KOKORO_SPEED=1.0

# --- Agent -------------------------------------------------------------------
# Steps stay unlimited: capping them abandons a task that is making progress.
AGENT_MAX_ITERATIONS=0
# Time and quota are the real ceilings, and they bound the failure rather than
# the task. 0 disables either, at the cost of nothing structurally preventing a
# goal from running until the LLM provider rate-limits it.
AGENT_MAX_SECONDS=180
PLANNER_MAX_CALLS_PER_GOAL=40
SCREENSHOT_MAX_WIDTH=1280
# Fewest actionable controls a window can report and still be planned for from
# its element list rather than from a marked screenshot.
OBSERVABILITY_MIN_ACTIONABLE=8

# Browser DOM via Chrome DevTools Protocol. Attach-only: Grace never launches a
# browser with a debug flag and never touches your profile. 0 = disabled, in
# which case browser elements come from the UIA/ARIA tree (all browsers).
GRACE_CDP_PORT=0

# OculiX/JPype visual fallback. Starts a JVM in-process; off by default.
USE_OCULIX=false

# --- Logging -----------------------------------------------------------------
# DEBUG formats a log line per 32ms audio chunk. Use only when debugging.
GRACE_LOG_LEVEL=INFO

# --- WebSocket (frontend) ----------------------------------------------------
WS_HOST=127.0.0.1
WS_PORT=8765
# Extra origins to accept connections from, beyond the built-in Tauri/dev
# allowlist (comma-separated). Leave empty unless the renderer is served from
# somewhere non-standard.
WS_ALLOWED_ORIGINS=
