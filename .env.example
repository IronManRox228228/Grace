# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
# Empty values are IGNORED (the config.py default is used instead), so delete a
# line rather than blanking it if you want the default. Values already present
# in the real environment always win over this file.

# --- Secrets -----------------------------------------------------------------
# Google AI Studio key. Grace only ever calls gemini-3.1-flash-lite.
# Leave empty to run fully local against llama-server.
GEMINI_API_KEY=

# --- Model paths -------------------------------------------------------------
# UI-TARS is the GUI grounding model. The mmproj file is required for vision;
# without it llama-server starts but UI-TARS runs blind.
LLAMA_MODEL_PATH=C:\path\to\UI-TARS-1.5-7B.Q4_K_M.gguf
LLAMA_MMPROJ_PATH=C:\path\to\UI-TARS-1.5-7B.mmproj-Q8_0.gguf
KOKORO_VOICES_PATH=C:\Users\<you>\.cache\huggingface\hub\models--hexgrad--Kokoro-82M\snapshots\<snapshot>\voices\af_bella.pt

# --- llama-server ------------------------------------------------------------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CONTEXT_WINDOW=8192
LLAMA_NGL=999
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16

# --- Cloud LLM ---------------------------------------------------------------
USE_CLOUD_LLM=true
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
USE_UI_TARS_LOCAL=true

# --- Audio -------------------------------------------------------------------
MIC_DEVICE_INDEX=-1
MIC_SAMPLE_RATE=16000
MIC_CHUNK=512
MIC_CHANNELS=1
MIC_WIDTH=2
FOLLOWUP_TIMEOUT_SECONDS=10

# --- Wake word (Vosk) --------------------------------------------------------
VOSK_KEYWORD=grace
VOSK_THRESHOLD=0.4

# --- Whisper -----------------------------------------------------------------
WHISPER_MODEL_PATH=small
WHISPER_VAD_THRESHOLD=0.008
WHISPER_SILENCE_DURATION_MS=700

# --- Kokoro TTS --------------------------------------------------------------
# Workers share a single KModel, so this is concurrency, not model copies.
KOKORO_WORKERS=2
KOKORO_DEVICE=cuda
KOKORO_DTYPE=float32
KOKORO_WARMUP=true
KOKORO_CACHE_SIZE=32

# --- Agent -------------------------------------------------------------------
AGENT_MAX_ITERATIONS=12
PLANNER_MAX_CALLS_PER_GOAL=8
SCREENSHOT_MAX_WIDTH=1280

# Browser DOM via Chrome DevTools Protocol. Attach-only: Grace never launches a
# browser with a debug flag and never touches your profile. 0 = disabled, in
# which case browser elements come from the UIA/ARIA tree (all browsers).
GRACE_CDP_PORT=0

# OculiX/JPype visual fallback. Starts a JVM in-process; off by default.
USE_OCULIX=false

# --- Logging -----------------------------------------------------------------
# DEBUG formats a log line per 32ms audio chunk. Use only when debugging.
GRACE_LOG_LEVEL=INFO

# --- WebSocket (frontend) ----------------------------------------------------
WS_HOST=127.0.0.1
WS_PORT=8765
