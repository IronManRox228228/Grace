{
  "name": "grace",
  "version": "0.1.0",
  "description": "Grace — an offline, voice-first accessibility assistant overlay for Windows.",
  "private": true,
  "scripts": {
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc --noEmit --project renderer/tsconfig.json",
    "dev": "cd .. && tauri dev",
    "build": "cd .. && tauri build",
    "tauri": "cd .. && tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
